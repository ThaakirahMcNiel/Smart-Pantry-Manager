<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F7F9F4">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pantry_title"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#244B35"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pantry_subtitle"
        android:textSize="16sp"
        android:textColor="#52665A"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnAddIngredient"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/add_ingredient"
        android:textAllCaps="false" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/my_pantry"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#244B35"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp" />

    <ListView
        android:id="@+id/listPantry"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DCE4DC"
        android:dividerHeight="1dp"
        android:paddingBottom="8dp" />

    <TextView
        android:id="@+id/txtEmptyPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_pantry"
        android:textSize="16sp"
        android:textColor="#52665A"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

</LinearLayout>
