<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#F7F9F4">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/suggested_recipes_title"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#244B35"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/suggested_recipes_subtitle"
        android:textSize="16sp"
        android:textColor="#52665A"
        android:layout_marginBottom="16dp" />

    <ListView
        android:id="@+id/listSuggestedRecipes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#DCE4DC"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/txtNoRecipes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_matching_recipes"
        android:textSize="16sp"
        android:textColor="#52665A"
        android:gravity="center"
        android:padding="16dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnBackToPantry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/back_to_pantry"
        android:textAllCaps="false" />

</LinearLayout>
