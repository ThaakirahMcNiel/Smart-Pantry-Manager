<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
    android:padding="16dp"
    android:background="#F8F5FF">

    <Button
        android:id="@+id/btnHomeOpenDrawer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="☰"
        android:textSize="24sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6D28D9"
        android:contentDescription="Open navigation menu" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Smart Pantry Manager"
        android:textColor="#3B0764"
        android:textSize="28sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Your kitchen, organised."
        android:textColor="#6D28D9"
        android:textSize="18sp"
        android:gravity="center" />

</LinearLayout>
